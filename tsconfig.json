{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024", "ESNext.Temporal"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    // scripts/indic.ts is imported by an .mjs generator under Node's erase-only type stripping, which
    // rejects parameter properties, enums and namespaces at import time. This turns that into a
    // typecheck error instead of a runtime one the next contributor discovers.
    "erasableSyntaxOnly": true,
    // The same module is imported by test/rabjung-names.test.ts, which must name it as "indic.ts":
    // Node resolves the real filename, and there is no .js to point at because nothing compiles
    // scripts/. Legal only because this config is noEmit; tsconfig.build.json turns it back off,
    // since that one emits and covers src/ alone, which never imports scripts/.
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "noEmit": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "scripts/**/*.ts", "*.config.ts"]
}
