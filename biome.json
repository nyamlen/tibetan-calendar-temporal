{
  "$schema": "https://biomejs.dev/schemas/2.5.8/schema.json",
  "files": {
    "includes": [
      "src/**/*.ts",
      "test/**/*.ts",
      "bench/**/*.ts",
      "scripts/**/*.mjs",
      "scripts/**/*.ts",
      "*.ts",
      "*.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "lineEnding": "lf",
    "indentStyle": "tab",
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedImports": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "json": {
    "formatter": {
      "indentStyle": "space",
      "indentWidth": 2
    }
  },
  "overrides": [
    {
      "includes": ["test/fixtures/fpmt-observances.ts"],
      "formatter": { "lineWidth": 250 }
    },
    {
      "includes": ["src/**/*.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "Date": "Use Temporal.PlainDate. `Date` carries a time zone and a time of day the calendar has no use for, and its arithmetic is not deterministic across platforms — which is the whole property this engine sells. Scoped to src/ so scripts/ and test/ may still use it."
                }
              }
            }
          }
        }
      }
    }
  ]
}
