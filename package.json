{
  "name": "tibetan-calendar-temporal",
  "version": "0.0.1",
  "description": "Tibetan calendar (Phugpa tradition) computation engine built on Temporal. Pre-release placeholder — implementation in development.",
  "type": "module",
  "license": "MIT",
  "author": "Andreas Bothner <contact@nyamlen.app>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nyamlen/tibetan-calendar-temporal.git"
  },
  "homepage": "https://github.com/nyamlen/tibetan-calendar-temporal#readme",
  "bugs": "https://github.com/nyamlen/tibetan-calendar-temporal/issues",
  "keywords": [
    "tibetan",
    "calendar",
    "temporal",
    "phugpa",
    "buddhist",
    "lunisolar",
    "tibetan-calendar",
    "losar"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./observances": {
      "types": "./dist/observances/index.d.ts",
      "default": "./dist/observances/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node --eval \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:pack": "node scripts/check-pack.mjs",
    "coverage": "vitest run --coverage",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check:links": "node scripts/check-links.mjs",
    "check:publish": "npm run build && publint && attw --pack . --profile esm-only"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@biomejs/biome": "^2.5.8",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "fast-check": "^4.9.0",
    "publint": "^0.3.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=26"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
