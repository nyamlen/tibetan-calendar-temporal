// Repo-level markdownlint config. Rules disabled here conflict with conventions the
// docs follow deliberately — without this, `docs/` reports ~240 violations that are all
// working as intended.
{
  // Semantic line breaks: one sentence or clause per line, so Git diffs stay limited to
  // the sentence that changed. Sentences routinely exceed any fixed column limit, and
  // hard-wrapping mid-sentence is exactly what the convention exists to prevent.
  "MD013": false,

  // Table pipe padding. Purely cosmetic, and the tables are hand-maintained.
  "MD060": false,

  // Bold labels used as sub-headings — `**Package**`, `**Publishing**` — group the
  // pre-v1.0.0 checklist in docs/development/roadmap.md. Promoting them to real headings would put
  // internal checklist sections in every table of contents.
  "MD036": false,

  // Adjacent blockquotes separated by a blank line. The docs use `>` callouts heavily and
  // two consecutive ones — a clean-room note followed by a settled-fork note, in
  // docs/development/testing.md — are distinct notes, not one quote with a hole in it. GitHub renders
  // them as two. The rule guards against parsers that merge them; ours does not.
  "MD028": false,

  // Inline HTML. README.md uses <details>/<summary> for the collapsible asides, which has no
  // Markdown equivalent and degrades to visible text on renderers that do not support it.
  // Listed rather than disabled, so unexpected HTML is still caught.
  "MD033": { "allowed_elements": ["details", "summary", "strong"] },

  // Carried over from the user-level VS Code settings so behaviour does not change
  // when this file takes precedence.
  "MD031": false,
  "MD022": { "lines_above": 1, "lines_below": 0 }
}
