# Local IDE and System Settings
.vscode/
.kiro/
.serena/
.DS_Store
Thumbs.db

# Agent tooling. Personal, machine-specific, and this repository goes public at
# v1.0.0 — `.mcp.json` records absolute local paths, and settings.local.json is
# per-machine permission overrides. Shared `.claude/settings.json` stays tracked
# so any project-wide agent config can still be reviewed in a PR.
.mcp.json
.claude/settings.local.json

# Playwright MCP drops page snapshots here, in whatever directory the session
# was started from. Transient agent scratch output, never project artifacts.
.playwright-mcp/

# Build and Compilation Outputs
dist/
build/
out/

# Dependency Directories
node_modules/
jspm_packages/
web_modules/

# Logs and Diagnostics
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment and Secrets (Never commit these!)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# TypeScript / Testing caching
.eslintcache
.tsbuildinfo
*.tsbuildinfo
coverage/

# Subagent-driven-development scratch workspace (ledgers, briefs, review packages)
.superpowers/
